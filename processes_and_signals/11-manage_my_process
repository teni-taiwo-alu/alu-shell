#!/usr/bin/env bash
# Manages the manage_my_process background process.

SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd)"
PID_FILE="/var/run/my_process.pid"

start_process() {
    nohup "$SCRIPT_DIR/manage_my_process" >/dev/null 2>&1 &
    echo $! > "$PID_FILE"
}

stop_process() {
    if [ -f "$PID_FILE" ]; then
        pid=$(cat "$PID_FILE")
        kill "$pid" 2>/dev/null || true
        rm -f "$PID_FILE"
    fi
}

case "$1" in
    start)
        start_process
        echo "manage_my_process started"
        ;;
    stop)
        stop_process
        echo "manage_my_process stopped"
        ;;
    restart)
        stop_process
        start_process
        echo "manage_my_process restarted"
        ;;
    *)
        echo "Usage: manage_my_process {start|stop|restart}"
        exit 1
        ;;
esac
